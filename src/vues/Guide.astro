---
import Base from '../layouts/Base.astro';
import Texte from '../components/Texte.astro';
import Chat from '../components/demo/Chat.astro';
import Widget from '../components/demo/Widget.astro';
import { GUIDES, GUIDES_CLES, lien, TEXTES, type GuideCle, type Lang } from '../i18n';

interface Props { lang: Lang; cle: GuideCle }
const { lang, cle } = Astro.props;
const g = GUIDES[lang][cle];
const c = TEXTES[lang].commun;
const autres = GUIDES_CLES.filter((k) => k !== cle);
const sansMarques = (s: string) => s.replace(/\*\*|`/g, '');
const absolu = (chemin: string) => new URL(chemin, Astro.site).href;

// Trois données structurées : les étapes (HowTo), les questions (FAQPage)
// et le fil d'Ariane, que Google peut afficher sous le titre du résultat.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'HowTo', name: g.h1, description: sansMarques(g.intro), inLanguage: lang, url: absolu(lien(lang, cle)),
      step: g.etapes.map(([nom, texte], i) => ({ '@type': 'HowToStep', position: i + 1, name: nom, text: sansMarques(texte) })),
    },
    {
      '@type': 'FAQPage', inLanguage: lang,
      mainEntity: g.faq.map(([q, r]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: sansMarques(r) } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'OBS Dynamics', item: absolu(lien(lang)) },
        { '@type': 'ListItem', position: 2, name: g.court, item: absolu(lien(lang, cle)) },
      ],
    },
  ],
};
---
<Base lang={lang} page={cle} title={g.titre} description={g.description} jsonLd={jsonLd}>
  <article class="guide">
    <p class="ariane mono"><a href={lien(lang)}>OBS Dynamics</a> › {c.guides}</p>
    <h1 class="titre-page">{g.h1}</h1>
    <p class="reponse"><Texte texte={g.intro} /></p>
    <p><a class="btn btn-primaire" href={lien(lang, 'installation')}>{c.telechargerWindows}</a></p>

    {g.demo === 'widget' && <div class="demo"><Widget /></div>}
    {g.demo === 'chat' && <div class="demo"><Chat messages={TEXTES[lang].accueil.modules.messages} /></div>}

    <section aria-labelledby="titre-etapes">
      <h2 id="titre-etapes">{g.etapesTitre}</h2>
      <ol class="etapes">
        {g.etapes.map(([titre, texte]) => (
          <li><h3>{titre}</h3><p><Texte texte={texte} /></p></li>
        ))}
      </ol>
    </section>

    {g.sections.map(([titre, texte]) => (
      <section><h2>{titre}</h2><p><Texte texte={texte} /></p></section>
    ))}

    <section aria-labelledby="titre-questions">
      <h2 id="titre-questions">{c.questionsFrequentes}</h2>
      <dl class="faq">
        {g.faq.map(([q, r]) => <div><dt>{q}</dt><dd><Texte texte={r} /></dd></div>)}
      </dl>
    </section>

    <aside class="autres" aria-labelledby="titre-autres">
      <h2 id="titre-autres">{c.autresGuides}</h2>
      <ul>
        {autres.map((k) => <li><a href={lien(lang, k)}>{GUIDES[lang][k].court}</a></li>)}
      </ul>
    </aside>
  </article>
</Base>

<script>
  import '../scripts/motion';
</script>

<style>
  .guide { max-width: 48rem; padding: clamp(2.5rem, 7vw, 4.5rem) 0 1rem; }
  .ariane { font-size: .78rem; color: var(--texte-doux); margin: 0 0 1.25rem; }
  .ariane a { color: var(--accent); text-decoration: none; }
  .guide .titre-page { font-size: clamp(2.1rem, 5.5vw, 3.6rem); }
  .reponse { font-size: 1.2rem; color: var(--texte); margin: 0 0 1.5rem; }
  .guide h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem); line-height: 1.15; margin: 3rem 0 1rem;
    font-variation-settings: 'wdth' 80;
  }
  .guide section > p { color: var(--texte-doux); margin: 0; }
  .guide :is(strong, code) { color: var(--texte); }
  .demo { margin: 2.5rem 0 0; border: 1px solid var(--ligne); border-radius: 1rem; background: var(--surface); overflow: hidden; }

  .etapes { list-style: none; counter-reset: etape; margin: 0; padding: 0; }
  .etapes li {
    counter-increment: etape; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: .3rem 1.25rem; padding: 1.25rem 0; border-top: 1px solid var(--ligne);
  }
  .etapes li > * { grid-column: 2; }
  .etapes li::before {
    content: '0' counter(etape); grid-row: 1 / span 2;
    font-family: var(--mono); font-size: 1.6rem; line-height: 1; color: var(--accent);
  }
  .etapes h3 { margin: 0; font-size: 1.1rem; }
  .etapes p { margin: 0; color: var(--texte-doux); }

  .faq { margin: 0; }
  .faq div { padding: 1rem 0; border-top: 1px solid var(--ligne); }
  .faq dt { font-weight: 700; margin-bottom: .3rem; }
  .faq dd { margin: 0; color: var(--texte-doux); }

  .autres { margin-top: 3rem; padding: 1.5rem; border: 1px solid var(--ligne); border-radius: 1rem; background: var(--surface); }
  .autres h2 { margin: 0 0 .75rem; font-size: 1.15rem; }
  .autres ul { margin: 0; padding-left: 1.1rem; display: grid; gap: .4rem; }
</style>
