---
// Sous-titres : rendu proche du préréglage « Contour » du widget
// (subtitles_style.py). Les mots arrivent un par un, le dernier reste
// « provisoire » (plus pâle) comme dans le vrai widget, puis la phrase repart.
interface Props { phrase: string; etiquette: string }
const { phrase, etiquette } = Astro.props;
const mots = phrase.split(' ');
---
<div class="st-scene" data-demo="sous-titres" aria-hidden="true">
  <span class="st-cc mono">{etiquette}</span>
  <p class="st-ligne">
    {mots.map((mot) => <span>{mot}</span>)}
  </p>
</div>
<p class="sr-only">{phrase}</p>

<style>
  .st-scene {
    position: relative; height: 19rem; overflow: hidden;
    display: flex; align-items: flex-end; justify-content: center;
    padding: 0 1.25rem 1.75rem;
    /* Même décor de jeu stylisé que la démo du chat. */
    background:
      linear-gradient(180deg, rgba(11, 15, 23, 0) 40%, rgba(11, 15, 23, .7)),
      repeating-linear-gradient(115deg, #1b2a3a 0 40px, #1f3242 40px 80px);
  }
  .st-cc {
    position: absolute; top: .9rem; right: .9rem;
    font-size: .75rem; font-weight: 700; color: #0b0f17;
    background: #e8edf2; border-radius: .25rem; padding: .1rem .4rem;
  }
  .st-ligne {
    margin: 0; max-width: 30rem; text-align: center; text-wrap: balance;
    font-family: var(--titre); font-weight: 800;
    font-size: clamp(1.2rem, 3.2vw, 1.6rem); line-height: 1.25; color: #fff;
    -webkit-text-stroke: 5px #000; paint-order: stroke fill;
  }
  .st-ligne span {
    display: inline-block; margin: 0 .14em;
    animation: st-mot 9s infinite both;
  }
  /* Pas de style en ligne (CSP) : un délai par position, 12 mots au plus. */
  .st-ligne span:nth-child(1) { animation-delay: 0.00s; }
  .st-ligne span:nth-child(2) { animation-delay: 0.35s; }
  .st-ligne span:nth-child(3) { animation-delay: 0.70s; }
  .st-ligne span:nth-child(4) { animation-delay: 1.05s; }
  .st-ligne span:nth-child(5) { animation-delay: 1.40s; }
  .st-ligne span:nth-child(6) { animation-delay: 1.75s; }
  .st-ligne span:nth-child(7) { animation-delay: 2.10s; }
  .st-ligne span:nth-child(8) { animation-delay: 2.45s; }
  .st-ligne span:nth-child(9) { animation-delay: 2.80s; }
  .st-ligne span:nth-child(10) { animation-delay: 3.15s; }
  .st-ligne span:nth-child(11) { animation-delay: 3.50s; }
  .st-ligne span:nth-child(12) { animation-delay: 3.85s; }
  .st-ligne span:last-child { animation-name: st-dernier; }
  @keyframes st-mot {
    0% { opacity: 0; }
    3%, 88% { opacity: 1; }
    94%, 100% { opacity: 0; }
  }
  @keyframes st-dernier {
    0% { opacity: 0; }
    3%, 20% { opacity: .55; }
    24%, 88% { opacity: 1; }
    94%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-ligne span { animation: none; }
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
</style>
